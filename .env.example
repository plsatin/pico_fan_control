# --- InfluxDB ---
INFLUXDB_HOST=127.0.0.1
INFLUXDB_PORT=8086
INFLUXDB_USER=
INFLUXDB_PASSWORD=
INFLUXDB_DB=icinga2
INFLUXDB_MEAS_FAN=smart-fan
INFLUXDB_MEAS_GPU=docker-01

# --- HTTP / WebSocket ---
HTTP_HOST=0.0.0.0
HTTP_PORT=3000
# Сгенерируйте случайную строку, например:
#   python -c "import secrets; print(secrets.token_hex(16))"
FLASK_SECRET=

# --- Polling ---
POLL_INTERVAL=2.0
GPU_TAG=GPU0
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# --- Fan (Raspberry Pi Pico) ---
# Оставьте пустым для автоопределения по VID/PID.
# Примеры:
#   Windows: COM5
#   Linux:   /dev/ttyACM0
FAN_PORT=
FAN_BAUDRATE=115200
FAN_TIMEOUT=2.0

# --- Fan control curve (defaults; can be changed at runtime via web UI) ---
# FAN_MODE: auto (управление по температуре GPU) или manual (фиксированный ШИМ)
FAN_MODE=auto
# Диапазон температур GPU (nvidia-smi), в котором наращиваются обороты (°C)
FAN_TEMP_MIN=50.0
FAN_TEMP_MAX=75.0
# Минимальный и максимальный ШИМ вентилятора (% от 65535)
FAN_PWM_MIN=30
FAN_PWM_MAX=100
# Запас от FAN_TEMP_MIN при остывании (°C) - анти-осцилляция
FAN_HYSTERESIS=3.0
# Фиксированный ШИМ в ручном режиме (%)
FAN_MANUAL_PWM=0
