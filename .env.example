# --- InfluxDB ---
INFLUXDB_HOST=127.0.0.1
INFLUXDB_PORT=8086
INFLUXDB_USER=
INFLUXDB_PASSWORD=
INFLUXDB_DB=icinga2
INFLUXDB_MEAS_FAN=smart-fan
INFLUXDB_MEAS_GPU=docker-01

# --- HTTP / WebSocket ---
HTTP_HOST=0.0.0.0
HTTP_PORT=3000
# Сгенерируйте случайную строку, например: python -c "import secrets; print(secrets.token_hex(16))"
FLASK_SECRET=

# --- Polling ---
POLL_INTERVAL=2.0
GPU_TAG=GPU0
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# --- Fan (Raspberry Pi Pico) ---
# Оставьте пустым для автоопределения по VID/PID.
# Примеры:
#   Windows: COM5
#   Linux:   /dev/ttyACM0
FAN_PORT=/dev/ttyACM0
FAN_BAUDRATE=115200
FAN_TIMEOUT=2.0
